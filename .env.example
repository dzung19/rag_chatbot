# =============================================================================
# RAG Chatbot — Environment Configuration
# Copy this file to .env and update values as needed.
# NEVER commit .env to version control.
# =============================================================================

# --- Authentication ---
# API key for accessing the chatbot API. Generate a strong random key.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY

# --- LLM Configuration ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma4:e4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=8192       # Context window size (8192 for 16GB RAM/GPU, 16384-32768 for 32GB+ RAM)
OLLAMA_NUM_PARALLEL=1     # Parallel requests in Ollama (1 for low RAM, 2-4 for high RAM)
# OLLAMA_NUM_THREADS=8    # Optional CPU threads limit (recommended: physical CPU cores)
# OLLAMA_NUM_PREDICT=1024 # Max output tokens per response
LLM_MAX_CONCURRENCY=1     # Max concurrent requests in RAG engine (matches OLLAMA_NUM_PARALLEL)
LLM_QUEUE_TIMEOUT=120     # Maximum wait time in queue before returning 503

# --- Qdrant ---
QDRANT_URL=https://your-qdrant-cluster-url.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=rag_documents

# --- Document Processing ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_UPLOAD_SIZE_MB=50
EXCEL_CHUNK_CHARS=4000
EXCEL_MAX_ROWS_PER_SHEET=200000
EXCEL_MAX_COLS=50
EXCEL_FULL_INDEX_ROWS=2000
EXCEL_MAX_CHUNKS_PER_FILE=500
EXCEL_TABLE_GAP_ROWS=2
EXCEL_SPARSE_THRESHOLD=0.4

# --- Service URLs (internal Docker network) ---
INGESTION_SERVICE_URL=http://ingestion:8001
RAG_ENGINE_SERVICE_URL=http://rag-engine:8002
CONVERSATION_SERVICE_URL=http://conversation:8005
GATEWAY_URL=http://gateway:8000

# --- Conversation / Chat History Service ---
INTERNAL_SERVICE_KEY=CHANGE_ME_INTERNAL_KEY
CONVERSATION_DATABASE_URL=sqlite:////app/shared_data/chat_history.db

# --- PostgreSQL Database ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=rag_chatbot
DATABASE_URL=postgresql+psycopg://rag_user:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/rag_chatbot

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Logging ---
LOG_LEVEL=INFO
LOKI_URL=http://loki:3100

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- OneDrive/SharePoint (Phase 2) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_SITE_NAME=
# SHAREPOINT_DRIVE_NAME=

# --- Admin Permissions ---
ADMIN_RESTORE_ENABLED=true
ADMIN_USER_IDS=local-dev-user
