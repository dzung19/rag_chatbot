# Secrets: dien gia tri moi tai may, khong commit
API_KEY=test-api-key-123456
INTERNAL_SERVICE_KEY=local-conversation-service-key

# Ollama tren Windows host
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:latest
OLLAMA_EMBED_MODEL=nomic-embed-text-v2-moe
OLLAMA_TIMEOUT=300

# Qdrant: service trong cung Compose network
QDRANT_HOST=http://qdrant:6333
QDRANT_COLLECTION=rag_documents

# Backend services
INGESTION_SERVICE_URL=http://ingestion:8001
RAG_ENGINE_SERVICE_URL=http://rag-engine:8002
CONVERSATION_SERVICE_URL=http://conversation:8005
GATEWAY_URL=http://gateway:8000

# Tam giu connector va Loki tren Windows host
ONEDRIVE_CONNECTOR_URL=http://host.docker.internal:8004
LOKI_URL=http://host.docker.internal:3100

# SQLite trong container; can mount volume tai /app/data
CONVERSATION_DATABASE_URL=sqlite:////app/data/chat_history.db

# Relational Database - PostgreSQL
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_chatbot
DATABASE_URL=postgresql+psycopg://rag_user:rag_password@postgres:5432/rag_chatbot

LOG_LEVEL=INFO

# Dev only: dieu chinh theo origin UI thuc te
CORS_ORIGINS=http://localhost:3000

# Tam tat admin khi chua xac minh authentication that
ADMIN_RESTORE_ENABLED=false
ADMIN_USER_IDS=local-dev-user

# Dien lai thong tin tai may, khong gui secret
AZURE_TENANT_ID=<TENANT_ID>
AZURE_CLIENT_ID=<CLIENT_ID>
AZURE_CLIENT_SECRET=<NEW_CLIENT_SECRET>

SHAREPOINT_DOMAIN=<SHAREPOINT_DOMAIN>
SHAREPOINT_SITE_PATH=<SHAREPOINT_SITE_PATH>
SHAREPOINT_DRIVE_NAME=<DRIVE_NAME>